<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_back" />

            <TextView
                android:text="@string/profile_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/btnSetting"
                android:src="@drawable/ic_setting"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </LinearLayout>

        <!-- PROFILE -->
        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="76dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:src="@drawable/avatar" />

        <TextView
            android:id="@+id/txtName"
            android:text="Nguyen Van A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtEmail"
            android:text="nguyen.vana@gmail.com"
            android:gravity="center"
            android:textColor="#888"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtStatus"
            android:text="@string/premium_member"
            android:textColor="@android:color/background_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- ACCOUNT SETTINGS -->
        <TextView
            android:text="@string/account_settings"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/itemPersonalInfo"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_personalinfo"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="@string/personal_info"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemSecurity"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_security"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="@string/security_settings"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemLanguage"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_language"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="@string/language"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>

        <!-- PREFERENCES -->
        <TextView
            android:text="@string/preferences"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/itemNotification"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_notification"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="@string/notifications"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>
        <!-- ADD TRANSACTION -->
        <LinearLayout
            android:id="@+id/itemAddTransaction"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_add"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="Add Transaction"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>


        <!-- CATEGORY MANAGEMENT -->
        <LinearLayout
            android:id="@+id/itemCategory"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_add"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="Manage Category"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/itemDefaultCurrency"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_default_currency"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="@string/default_currency"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>

        <!-- SUPPORT -->
        <TextView
            android:text="@string/support"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/itemHelp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_help"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="@string/help_center"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#2ECC71"
            android:text="@string/logout"
            android:textColor="@android:color/background_dark"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/app_version"
            android:textColor="#BBB"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>